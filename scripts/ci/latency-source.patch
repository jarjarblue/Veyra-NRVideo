diff --git a/tests/qml/quick/tst_amd_latency.qml b/tests/qml/quick/tst_amd_latency.qml
new file mode 100644
index 0000000..47d0a21
--- /dev/null
+++ b/tests/qml/quick/tst_amd_latency.qml
@@ -0,0 +1,51 @@
+import QtQuick
+import QtQuick.Layouts
+import QtTest
+import Veyra
+import VeyraTest 1.0
+Item {
+    width: 800; height: 500
+    QtObject {
+        id: bridge
+        property bool amdAntiLagAvailable: true
+        property bool amdAntiLag: false
+        property bool xessResponsiveFallback: false
+        property bool presentationOwned: false
+        property string fgBackendName: "fsr3"
+    }
+    ColumnLayout {
+        width: parent.width
+        AmdLatencyEditor { id: list; backend: bridge; namePrefix: "test-list" }
+        AmdLatencyEditor { id: node; backend: bridge; namePrefix: "test-node" }
+    }
+    TestCase {
+        name: "AmdLatencyOwnership"
+        when: windowShown
+        function init(){
+            bridge.amdAntiLagAvailable=true;bridge.amdAntiLag=false
+            bridge.xessResponsiveFallback=false;bridge.presentationOwned=false
+            bridge.fgBackendName="fsr3";wait(20)
+        }
+        function anti(editor){return findChild(editor,editor.namePrefix+"-amd-anti-lag")}
+        function fallback(editor){return findChild(editor,editor.namePrefix+"-xess-responsive-fallback")}
+        function test_defaults_and_shared_preference(){
+            compare(bridge.amdAntiLag,false);compare(bridge.xessResponsiveFallback,false)
+            mouseClick(anti(list))
+            compare(bridge.amdAntiLag,true);compare(anti(node).checked,true)
+            mouseClick(anti(node))
+            compare(bridge.amdAntiLag,false);compare(anti(list).checked,false)
+        }
+        function test_xess_never_offers_stacked_anti_lag(){
+            bridge.amdAntiLag=true;bridge.fgBackendName="xess";wait(20)
+            compare(anti(list).enabled,false);compare(anti(node).enabled,false)
+            compare(bridge.amdAntiLag,true,"retained choice is not silently rewritten")
+            verify(fallback(list).visible)
+            mouseClick(fallback(list))
+            compare(bridge.xessResponsiveFallback,true);compare(fallback(node).checked,true)
+        }
+        function test_provider_owned_disables_native_control(){
+            bridge.presentationOwned=true;wait(20)
+            compare(anti(list).enabled,false)
+        }
+    }
+}
diff --git a/tests/unit/AntiLagSessionTests.cpp b/tests/unit/AntiLagSessionTests.cpp
new file mode 100644
index 0000000..4e67d66
--- /dev/null
+++ b/tests/unit/AntiLagSessionTests.cpp
@@ -0,0 +1,62 @@
+#include "veyra/gfx/AntiLagSession.h"
+#include "veyra/engine/PresentationSettings.h"
+#include <cstdio>
+#include <string>
+#include <thread>
+namespace {
+using Session=veyra::gfx::AntiLagSession;
+std::string calls;
+int creates=0,destroys=0;
+int32_t createResult=0,updateResult=0,endResult=0,typeResult=0;
+bool slow=false;
+int32_t create(void*,void** context){++creates;calls+='C';*context=createResult==0?&creates:nullptr;return createResult;}
+int32_t update(void*,bool on){calls+=on?'U':'D';if(on&&slow)std::this_thread::sleep_for(std::chrono::milliseconds(2));return on?updateResult:0;}
+int32_t end(void*){calls+='E';return endResult;}
+int32_t type(void*,bool generated){calls+=generated?'G':'R';return typeResult;}
+void destroy(void*){calls+='X';++destroys;}
+Session::DriverApi api(){return {create,update,end,type,destroy};}
+void reset(){calls.clear();creates=destroys=0;createResult=updateResult=endResult=typeResult=0;slow=false;}
+}
+int main(){
+    int failed=0,checks=0;
+    auto check=[&](bool ok,const char* name){++checks;if(!ok){++failed;std::printf("FAIL %s\n",name);}};
+    void* device=&failed;
+    reset();{
+        Session s(api());check(s.enable(device),"initialize");check(s.enable(device)&&creates==1,"enable is idempotent");
+        check(s.beginInput()&&s.beginInput()&&calls=="CU","waiting input delays only once");
+        s.submitted();s.submitted();s.present(true);s.present(true);s.present(true);s.present(false);
+        check(calls=="CUEGGGR","30 to 120: one input and end marker, three generated and one real output");
+        s.beginInput();s.cancelInput();s.beginInput();s.submitted();
+        check(calls.ends_with("UUE"),"cancelled input can start a new cycle");
+        s.close();s.close();check(destroys==1&&calls.ends_with("DX"),"disable and release once");
+    }
+    reset();{
+        createResult=-1;Session s(api());check(!s.enable(device)&&s.failed(),"unsupported driver fails closed");
+        s.beginInput();s.present(false);check(calls=="C"&&!s.active(),"unsupported driver receives no frame calls");
+        check(!s.enable(device)&&creates==1,"failure is latched until explicit reconfigure");
+        s.close();createResult=0;check(s.enable(device),"explicit retry after close");
+    }
+    reset();{
+        createResult=1;Session s(api());check(!s.enable(device)&&!s.active(),"S_FALSE is not initialization success");
+    }
+    for(int failure=0;failure<3;++failure){reset();{
+        Session s(api());s.enable(device);
+        if(failure==0)updateResult=-10;
+        if(failure==1)endResult=-11;
+        if(failure==2)typeResult=-12;
+        s.beginInput();s.submitted();s.present(true);
+        check(s.failed()&&!s.active()&&destroys==1,"frame failure disables and releases");
+        const auto before=calls;s.beginInput();s.submitted();s.present(false);check(calls==before,"no driver calls after failure");
+    }check(destroys==1,"failure plus destructor does not double release");}
+    reset();{
+        Session s(api());s.enable(device);slow=true;
+        for(int i=0;i<4;++i){s.beginInput(100);s.submitted();}
+        check(s.failed()&&!s.active(),"sustained long waits disable the latency consumer");
+    }
+    reset();{Session s(api());check(!s.enable(nullptr)&&creates==0,"no null device initialization");}
+    veyra::engine::PresentationSettings p;
+    check(!p.amdAntiLag&&!p.xessResponsiveFallback&&p.valid(),"new settings default off");
+    auto requested=p;requested.amdAntiLag=true;requested.xessResponsiveFallback=true;
+    check(requested.valid()&&requested!=p,"opt-ins participate in settings equality");
+    std::printf("AntiLagSession: %d checks, %d failures\n",checks,failed);return failed?1:0;
+}
diff --git a/tests/unit/XessFallbackCadenceTests.cpp b/tests/unit/XessFallbackCadenceTests.cpp
new file mode 100644
index 0000000..17a37bd
--- /dev/null
+++ b/tests/unit/XessFallbackCadenceTests.cpp
@@ -0,0 +1,35 @@
+#include "veyra/gfx/XessFallbackCadence.h"
+#include <cstdio>
+int main(){
+    using veyra::gfx::XessFallbackCadence;
+    int failed=0,checks=0;
+    auto check=[&](bool ok,const char* name){++checks;if(!ok){++failed;std::printf("FAIL %s\n",name);}};
+    // 120000 ticks/s: exact 30 Hz input, 120 Hz output, no rounding ambiguity.
+    XessFallbackCadence p;
+    check(p.deadline(10000,4000,1,3)==10000,"30 -> 120: no extra first-slot wait");
+    check(p.deadline(10000,4000,2,3)==11000,"second generated slot is 8.333 ms later");
+    check(p.deadline(11000,4000,3,3)==12000,"third generated slot stays on source-clock grid");
+    check(p.deadline(14000,4000,1,3)==14000,"next burst reanchors to actual readiness");
+    check(p.deadline(18000,4000,2,3)==18000,"GPU stall never queues an expired deadline");
+    check(p.deadline(18000,4000,3,3)==18000,"late second frame does not shift the remaining grid");
+    check(p.deadline(1000000,4000,1,3)==1000000,"pause/resume carries no old deadline debt");
+    check(p.deadline(1000000,4000,2,3)==1001000,"pause duration does not become source period");
+    p.reset();
+    for(unsigned generated=2;generated<=5;++generated){
+        int64_t last=0;
+        for(unsigned index=1;index<=generated;++index){
+            auto due=p.deadline(10000,6000,index,generated);
+            check(due>=last&&due<16000,"all multipliers stay ordered within one source period");last=due;
+        }
+    }
+    check(p.deadline(10000,0,1,3)==10000,"unknown period adds no delay");
+    check(p.deadline(10000,4000,0,3)==10000,"invalid frame index adds no delay");
+    check(p.deadline(10000,4000,1,1)==10000,"stock 2X is outside fallback scope");
+    // Simulated producer arrives every 4000 ticks for 10 seconds. A previous
+    // paced output cannot feed back and slow the source's 30 Hz clock.
+    for(int64_t start=10000;start<1210000;start+=4000){
+        const auto a=p.deadline(start,4000,1,3),b=p.deadline(start,4000,2,3),c=p.deadline(start,4000,3,3);
+        check(a==start&&b==start+1000&&c==start+2000,"10 second 30 -> 120 source-grid simulation");
+    }
+    std::printf("XeSS fallback cadence: %d checks, %d failures\n",checks,failed);return failed?1:0;
+}
