diff --git a/src/gfx/AntiLagSession.cpp b/src/gfx/AntiLagSession.cpp
new file mode 100644
index 0000000..5c80a01
--- /dev/null
+++ b/src/gfx/AntiLagSession.cpp
@@ -0,0 +1,34 @@
+#include <windows.h>
+#include <d3d12.h>
+#include <new>
+#include "veyra/gfx/AntiLagSession.h"
+#include "../../third_party/amd-anti-lag-2/ffx_antilag2_dx12.h"
+
+namespace veyra::gfx {
+namespace {
+using Context=AMD::AntiLag2DX12::Context;
+AntiLagSession::Result create(void* device,void** opaque){
+    *opaque=nullptr;
+    auto* context=new(std::nothrow) Context{};
+    if(!context)return E_OUTOFMEMORY;
+    const auto result=AMD::AntiLag2DX12::Initialize(context,static_cast<ID3D12Device*>(device));
+    if(result!=S_OK){AMD::AntiLag2DX12::DeInitialize(context);delete context;return result;}
+    *opaque=context;return S_OK;
+}
+AntiLagSession::Result update(void* context,bool enabled){
+    // Veyra's existing output cap remains the only frame-rate limiter.
+    return AMD::AntiLag2DX12::Update(static_cast<Context*>(context),enabled,0);
+}
+AntiLagSession::Result endRendering(void* context){
+    return AMD::AntiLag2DX12::MarkEndOfFrameRendering(static_cast<Context*>(context));
+}
+AntiLagSession::Result frameType(void* context,bool generated){
+    return AMD::AntiLag2DX12::SetFrameGenFrameType(static_cast<Context*>(context),generated);
+}
+void destroy(void* context){
+    auto* native=static_cast<Context*>(context);
+    AMD::AntiLag2DX12::DeInitialize(native);delete native;
+}
+}
+AntiLagSession::DriverApi nativeAntiLagApi(){return {create,update,endRendering,frameType,destroy};}
+}
