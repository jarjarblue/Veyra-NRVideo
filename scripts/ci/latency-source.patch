diff --git a/include/veyra/gfx/XessFallbackCadence.h b/include/veyra/gfx/XessFallbackCadence.h
new file mode 100644
index 0000000..c4e180e
--- /dev/null
+++ b/include/veyra/gfx/XessFallbackCadence.h
@@ -0,0 +1,27 @@
+#pragma once
+#include <algorithm>
+#include <cstdint>
+namespace veyra::gfx {
+// Opt-in fallback only: the Intel scheduler/tail limiter retain priority.
+// Integer tick arithmetic makes the 30 -> 120 schedule testable without a GPU.
+class XessFallbackCadence {
+    int64_t anchor_=0,period_=0;
+    uint64_t count_=0,lastIndex_=0;
+public:
+    void reset(){anchor_=period_=0;count_=lastIndex_=0;}
+    int64_t deadline(int64_t now,int64_t sourcePeriod,uint64_t index,uint64_t count){
+        if(now<=0||sourcePeriod<=0||index<1||index>count||count<2||count>5){reset();return now;}
+        // A late frame never pushes every remaining deadline forward. The
+        // first generated frame occupies the current slot; the other frames
+        // retain sourcePeriod/(count+1) spacing on the same absolute grid.
+        if(index==1||count!=count_||index<=lastIndex_||!anchor_){
+            anchor_=now;period_=sourcePeriod;count_=count;
+        }
+        lastIndex_=index;
+        const auto due=anchor_+(period_*int64_t(index-1))/int64_t(count+1);
+        // If readiness missed a slot, present immediately. Do not add a second
+        // source period to catch up, and do not invent new source timestamps.
+        return std::max(now,due);
+    }
+};
+}
