diff --git a/scripts/run-latency-contracts.py b/scripts/run-latency-contracts.py
new file mode 100644
index 0000000..ccc3f32
--- /dev/null
+++ b/scripts/run-latency-contracts.py
@@ -0,0 +1,49 @@
+"""Run driver-independent latency contracts; this does not build the player."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--output', type=Path, required=True)
+    parser.add_argument('--compiler', default='cl' if os.name == 'nt' else 'g++')
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parents[1]
+    output = args.output.resolve()
+    output.mkdir(parents=True, exist_ok=True)
+    results = []
+    for name, source in [('anti-lag', 'AntiLagSessionTests.cpp'),
+                         ('xess-fallback', 'XessFallbackCadenceTests.cpp')]:
+        executable = output / (name + ('.exe' if os.name == 'nt' else ''))
+        source_path = root / 'tests/unit' / source
+        if Path(args.compiler).stem.lower() == 'cl':
+            command = [args.compiler, '/nologo', '/std:c++20', '/EHsc', '/W4', '/WX',
+                       '/I' + str(root / 'include'), str(source_path), '/Fe:' + str(executable)]
+        else:
+            command = [args.compiler, '-std=c++20', '-Wall', '-Wextra', '-Werror',
+                       '-pedantic', '-pthread', '-I', str(root / 'include'),
+                       str(source_path), '-o', str(executable)]
+        built = subprocess.run(command, cwd=output, capture_output=True, text=True, timeout=120)
+        result = {'name': name, 'compile_command': command, 'compile_exit': built.returncode,
+                  'compile_output': built.stdout + built.stderr}
+        if built.returncode == 0:
+            ran = subprocess.run([str(executable)], cwd=output, capture_output=True,
+                                 text=True, timeout=30)
+            result.update(run_exit=ran.returncode, output=ran.stdout + ran.stderr,
+                          test_executable_sha256=hashlib.sha256(executable.read_bytes()).hexdigest())
+        results.append(result)
+    report = {'scope': 'driver-independent contracts only', 'tests': results,
+              'windows_player_built': False, 'qml_runtime_tested': False,
+              'radeon_driver_tested': False, 'physical_latency_measured': False}
+    (output / 'results.json').write_text(json.dumps(report, indent=2) + '\n', encoding='utf-8')
+    for result in results:
+        print(result.get('output', result['compile_output']), end='')
+    return 0 if all(r['compile_exit'] == 0 and r.get('run_exit') == 0 for r in results) else 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
