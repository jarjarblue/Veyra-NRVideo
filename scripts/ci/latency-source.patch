diff --git a/include/veyra/gfx/AntiLagSession.h b/include/veyra/gfx/AntiLagSession.h
new file mode 100644
index 0000000..b29edae
--- /dev/null
+++ b/include/veyra/gfx/AntiLagSession.h
@@ -0,0 +1,83 @@
+#pragma once
+#include <cstdint>
+#include <chrono>
+#include <bit>
+
+namespace veyra::gfx {
+// One session on the GPU owner thread. The opaque API keeps driver-independent
+// lifecycle tests runnable without a Windows graphics device.
+class AntiLagSession {
+public:
+    using Result = int32_t;
+    struct DriverApi {
+        Result (*create)(void* device, void** context) = nullptr;
+        Result (*update)(void* context, bool enabled) = nullptr;
+        Result (*endRendering)(void* context) = nullptr;
+        Result (*frameType)(void* context, bool generated) = nullptr;
+        void (*destroy)(void* context) = nullptr;
+    };
+    explicit AntiLagSession(DriverApi api):api_(api){}
+    ~AntiLagSession(){close();}
+    AntiLagSession(const AntiLagSession&) = delete;
+    AntiLagSession& operator=(const AntiLagSession&) = delete;
+
+    bool enable(void* device){
+        if(context_)return true;
+        if(failed_)return false;
+        if(!device||!api_.create||!api_.update||!api_.endRendering||!api_.frameType||!api_.destroy)
+            return fail(Result(0x80070057u));
+        const auto result=api_.create(device,&context_);
+        // AMD Initialize requires S_OK, not just a non-negative HRESULT.
+        if(result!=0||!context_)return fail(result?result:Result(0x80004002u));
+        return true;
+    }
+    void close(){
+        release();failed_=false;lastResult_=0;slowInputs_=0;
+    }
+    // Waiting/duplicate inputs keep their slot: one delay per accepted source,
+    // never one delay for every poll or generated output frame.
+    bool beginInput(uint64_t stallUs=0){
+        if(!context_||inputPending_)return !failed_;
+        const auto start=std::chrono::steady_clock::now();
+        const auto result=api_.update(context_,true);
+        if(result<0)return fail(result);
+        const auto elapsed=std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now()-start).count();
+        slowInputs_=uint16_t((slowInputs_<<1)|(stallUs&&uint64_t(elapsed)>stallUs));
+        // Source selection happens after this wait; sustained long waits on a
+        // video consumer can add latency rather than remove it. Fail closed.
+        if(std::popcount(slowInputs_)>=4)return fail(Result(0x800705b4u));
+        inputPending_=true;return true;
+    }
+    void submitted(){
+        if(!context_||!inputPending_)return;
+        inputPending_=false;
+        const auto result=api_.endRendering(context_);
+        if(result<0)fail(result);
+    }
+    void cancelInput(){inputPending_=false;}
+    void present(bool generated){
+        if(!context_)return;
+        const auto result=api_.frameType(context_,generated);
+        if(result<0)fail(result);
+    }
+    bool active()const{return context_!=nullptr;}
+    bool failed()const{return failed_;}
+    Result lastResult()const{return lastResult_;}
+private:
+    bool fail(Result result){lastResult_=result;failed_=true;release();return false;}
+    void release(){
+        inputPending_=false;
+        if(context_){
+            const auto result=api_.update(context_,false);
