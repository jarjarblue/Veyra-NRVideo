+ID3D12Resource* CapturePredictionSession::output(unsigned i)const{return i<2?p_->predicted[i].Get():nullptr;}
+bool CapturePredictionSession::due(int64_t now)const{
+    const auto& p=*p_;return p.initialized&&p.valid&&p.settings.capturePrediction&&!p.failed&&
