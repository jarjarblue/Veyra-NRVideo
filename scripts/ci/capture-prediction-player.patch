+import QtQuick
+import QtQuick.Layouts
+import QtTest
+import Veyra
+import VeyraTest 1.0
+Item {
+    width: 700; height: 900
+    QtObject {
+        id: bridge
+        property bool capturePrediction: false
+        property real predictionLeadMs: 8
+        property real predictionRefreshHz: 120
+        property real predictionMaxHorizonMs: 33
+        property bool predictionProtectHud: true
+    }
+    ColumnLayout {
+        width: parent.width
+        CapturePredictionEditor { id: list; backend: bridge; namePrefix: "pred-list" }
+        CapturePredictionEditor { id: node; backend: bridge; namePrefix: "pred-node" }
+    }
+    TestCase {
+        name: "CapturePredictionControls"
+        when: windowShown
+        function control(editor, name) { return findChild(editor,editor.namePrefix+"-"+name) }
+        function init(){bridge.capturePrediction=false;bridge.predictionLeadMs=8;bridge.predictionRefreshHz=120;bridge.predictionMaxHorizonMs=33;bridge.predictionProtectHud=true;wait(20)}
+        function test_enable_and_shared_controls(){
+            mouseClick(control(list,"capture-prediction"));compare(bridge.capturePrediction,true)
+            compare(control(node,"capture-prediction").checked,true)
+            control(list,"prediction-lead").commitValue(12.5)
+            compare(bridge.predictionLeadMs,12.5);compare(control(node,"prediction-lead").value,12.5)
+            control(list,"prediction-refresh").commitValue(144)
+            compare(bridge.predictionRefreshHz,144)
+            control(list,"prediction-horizon").commitValue(40)
+            compare(bridge.predictionMaxHorizonMs,40)
+            mouseClick(control(list,"prediction-hud"));compare(bridge.predictionProtectHud,false)
+        }
+        function test_slider_limits(){
+            bridge.capturePrediction=true;wait(20)
+            control(list,"prediction-lead").commitValue(999);compare(bridge.predictionLeadMs,30)
+            control(list,"prediction-refresh").commitValue(999);compare(bridge.predictionRefreshHz,240)
+            control(list,"prediction-horizon").commitValue(-20);compare(bridge.predictionMaxHorizonMs,1)
+        }
+    }
+}
