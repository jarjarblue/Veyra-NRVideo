+CapturePredictionSession::CapturePredictionSession():p_(std::make_unique<Impl>()){}
+CapturePredictionSession::~CapturePredictionSession()=default;
+bool CapturePredictionSession::initialize(ID3D12Device* device,ID3D12Resource* a,ID3D12Resource* b){
+    auto& p=*p_;if(!device||!a||!b)return false;
+    const auto d=a->GetDesc(),other=b->GetDesc();
+    if(!d.Width||!d.Height||d.Width>3840||d.Height>2160||other.Width!=d.Width||other.Height!=d.Height||other.Format!=d.Format)return false;
+    if(d.Format!=DXGI_FORMAT_R8G8B8A8_UNORM&&d.Format!=DXGI_FORMAT_B8G8R8A8_UNORM&&d.Format!=DXGI_FORMAT_R10G10B10A2_UNORM&&d.Format!=DXGI_FORMAT_R16G16B16A16_FLOAT)return false;
+    p.width=uint32_t(d.Width);p.height=d.Height;
+    const double scale=std::min(1.,640./std::max(p.width,p.height));
+    p.fw=std::max(32u,uint32_t(p.width*scale));p.fh=std::max(32u,uint32_t(p.height*scale));
+    p.transfer=d.Format==DXGI_FORMAT_R10G10B10A2_UNORM?2:d.Format==DXGI_FORMAT_R16G16B16A16_FLOAT?1:0;
+    // Include conservative DIS scratch allowance, in addition to our surfaces.
+    const uint64_t need=uint64_t(p.width)*p.height*32+uint64_t(p.fw)*p.fh*96+64*1024*1024;
+    ComPtr<IDXGIFactory4> factory;ComPtr<IDXGIAdapter3> adapter;
+    if(SUCCEEDED(CreateDXGIFactory1(IID_PPV_ARGS(&factory)))&&SUCCEEDED(factory->EnumAdapterByLuid(device->GetAdapterLuid(),IID_PPV_ARGS(&adapter)))){
+        DXGI_QUERY_VIDEO_MEMORY_INFO memory{};
+        if(SUCCEEDED(adapter->QueryVideoMemoryInfo(0,DXGI_MEMORY_SEGMENT_GROUP_LOCAL,&memory))&&memory.Budget>0&&
+            (memory.CurrentUsage>=memory.Budget||need>memory.Budget-memory.CurrentUsage)){log::warn("capture-prediction","insufficient local video-memory budget; original frames retained");return false;}
+    }
+    for(unsigned i=0;i<2;++i){
+        p.linear[i]=makeTexture(device,p.width,p.height,DXGI_FORMAT_R16G16B16A16_FLOAT,true);
+        p.predicted[i]=makeTexture(device,p.width,p.height,DXGI_FORMAT_R16G16B16A16_FLOAT,true);
+        p.flowColor[i]=makeTexture(device,p.fw,p.fh,DXGI_FORMAT_R8G8B8A8_UNORM,true);
+        p.motion[i]=makeTexture(device,p.fw,p.fh,DXGI_FORMAT_R16G16_FLOAT,true);
+        p.confidence[i]=makeTexture(device,p.fw,p.fh,DXGI_FORMAT_R16_FLOAT,true);
+        if(!p.linear[i]||!p.predicted[i]||!p.flowColor[i]||!p.motion[i]||!p.confidence[i])return false;
+    }
+    if(!p.flow.initialize(device,p.fw,p.fh))return false;
+    std::vector<uint8_t> shader;
+    if(!p.ingress.loadShader("CapturePredictionIngress.dxil",shader)||!p.ingress.create(device,shader,12,1,2,8,0,true))return false;
+    DescriptorStager stage;if(!stage.initialize(device,32))return false;
+    ID3D12Resource* inputs[]={a,b};
+    for(unsigned source=0;source<2;++source)for(unsigned i=0;i<2;++i){
+        const unsigned slot=(source*2+i)*3;
+        stage.stageSrv(inputs[source],nullptr,p.ingress.heap.Get(),slot);
+        makeUav(device,p.linear[i].Get(),DXGI_FORMAT_R16G16B16A16_FLOAT,cpuHandleOf(p.ingress,slot+1));
+        makeUav(device,p.flowColor[i].Get(),DXGI_FORMAT_R8G8B8A8_UNORM,cpuHandleOf(p.ingress,slot+2));
+    }
+    for(unsigned i=0;i<2;++i)if(!p.predict[i].initialize(device,{p.linear[i].Get(),p.linear[1-i].Get(),p.motion[i].Get(),p.motion[1-i].Get(),p.confidence[i].Get()},
+        {p.predicted[0].Get(),p.predicted[1].Get()}))return false;
+    p.initialized=true;
+    log::info("capture-prediction",std::format("GPU DIS + prediction initialized {}x{} flow={}x{}; native presentation, no future-frame wait",p.width,p.height,p.fw,p.fh));
+    return true;
+}
+void CapturePredictionSession::configure(PresentationSettings s){
+    if(p_->settings.capturePrediction!=s.capturePrediction)reset();p_->settings=s;
+}
+void CapturePredictionSession::reset(){auto& p=*p_;p.clock.clear();p.identity={};p.valid=false;p.imageHistory=false;p.flowPairs=0;p.sequence=0;p.lastPresent=0;p.nextRefresh=0;p.newInput=false;p.decision={};}
+ID3D12Resource* CapturePredictionSession::record(ID3D12GraphicsCommandList* list,ID3D12CommandQueue* queue,ID3D12Fence* fence,uint64_t completion,
+    unsigned sourceSlot,FrameIdentity id,int64_t pts,int64_t arrival,int64_t now,bool refresh){
+    auto& p=*p_;if(!p.initialized||!p.settings.capturePrediction||p.failed||sourceSlot>=2||!list||!queue||!fence)return nullptr;
+    CapturePredictionSettings settings;settings.enabled=true;settings.compensationMs=p.settings.predictionLeadMs;
+    settings.maxHorizonMs=p.settings.predictionMaxHorizonMs;settings.maxIntervalFraction=1;
+    settings.displayPeriodMs=1000/p.settings.predictionRefreshHz;settings.maxGpuMs=2;
+    const bool fresh=!p.valid||id!=p.identity;
+    if(refresh&&fresh)return nullptr;
+    if(fresh){
+        const bool resetHistory=!p.valid||id.epoch!=p.identity.epoch||id.settingsRevision!=p.identity.settingsRevision;
+        p.latest={id.epoch,id.settingsRevision,++p.sequence,pts,arrival,true,false,resetHistory};
+        const auto accepted=p.clock.accept(p.latest);
+        const auto preliminary=p.clock.decide(settings,now);
+        if(preliminary.reason==PredictionReason::Budget||preliminary.reason==PredictionReason::Stale){
+            p.identity=id;p.valid=true;p.lastArrival=arrival;p.imageHistory=false;p.flowPairs=0;p.decision=preliminary;return nullptr;
+        }
+        const auto old=p.parity;p.parity^=1;
+        const bool history=p.imageHistory&&!resetHistory&&accepted==PredictionReason::Ready;
+        if(!history)p.flowPairs=0;
+        const uint32_t dims[8]={p.width,p.height,p.fw,p.fh,p.transfer,0,0,0};
+        const unsigned slot=(sourceSlot*2+p.parity)*3;
+        // The producer handoff is GPU-side; both graph outputs are COMMON here.
+        p.states.transition(list,p.linear[p.parity].Get(),D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+        p.states.transition(list,p.flowColor[p.parity].Get(),D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+        p.ingress.bind(list,reinterpret_cast<const float*>(dims),gpuHandleOf(p.ingress,slot).ptr,gpuHandleOf(p.ingress,slot+1).ptr);
+        // Caller transitions the graph input to NON_PIXEL_SHADER_RESOURCE.
+        list->Dispatch((p.width+7)/8,(p.height+7)/8,1);
+        p.states.uavBarrier(list,p.linear[p.parity].Get());p.states.uavBarrier(list,p.flowColor[p.parity].Get());
+        p.states.transition(list,p.linear[p.parity].Get(),D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+        p.states.transition(list,p.flowColor[p.parity].Get(),D3D12_RESOURCE_STATE_COMMON);
+        if(history){
+            p.states.transition(list,p.flowColor[old].Get(),D3D12_RESOURCE_STATE_COMMON);
+            p.states.transition(list,p.motion[p.parity].Get(),D3D12_RESOURCE_STATE_COMMON);
+            p.states.transition(list,p.confidence[p.parity].Get(),D3D12_RESOURCE_STATE_COMMON);
+            if(!p.flow.dispatch(list,queue,fence,completion,p.parity,p.flowColor[old].Get(),p.flowColor[p.parity].Get(),p.motion[p.parity].Get(),p.confidence[p.parity].Get(),p.sequence-1,p.sequence)){
+                p.clock.clear();p.decision.reason=PredictionReason::Warmup;p.valid=false;p.imageHistory=false;p.flowPairs=0;p.failed=true;return nullptr;
+            }
+            p.flowPairs=std::min(2u,p.flowPairs+1);
+            p.states.set(p.motion[p.parity].Get(),D3D12_RESOURCE_STATE_COMMON);p.states.set(p.confidence[p.parity].Get(),D3D12_RESOURCE_STATE_COMMON);
+        }
+        p.identity=id;p.valid=true;p.imageHistory=true;p.lastArrival=arrival;p.newInput=true;
+    }
+    p.decision=p.clock.decide(settings,now);p.ageMs=arrival>0&&now>=arrival?double(now-arrival)/10000:0;
+    if(p.flowPairs==0){p.decision.reason=PredictionReason::Warmup;return nullptr;}
+    if(!p.decision.active())return nullptr;
+    CapturePredictionPass::Parameters parameters;parameters.historyValid=true;parameters.accelerationValid=p.decision.acceleration&&p.flowPairs>=2;
+    parameters.horizonFraction=float(p.decision.intervalFraction);parameters.intervalRatio=float(p.decision.intervalRatio);
+    if(p.settings.predictionProtectHud)parameters.protectedRegions={{{0,0,1,.10f},{0,.76f,.25f,1},{.75f,.76f,1,1},{.478f,.478f,.522f,.522f}}};
+    const unsigned output=sourceSlot;
+    if(!p.predict[p.parity].record(list,p.states,output,parameters))return nullptr;
+    p.states.transition(list,p.predicted[output].Get(),D3D12_RESOURCE_STATE_COMMON);
+    ++p.outputs;return p.predicted[output].Get();
+}
+ID3D12Resource* CapturePredictionSession::output(unsigned i)const{return i<2?p_->predicted[i].Get():nullptr;}
+bool CapturePredictionSession::due(int64_t now)const{
+    const auto& p=*p_;return p.initialized&&p.valid&&p.settings.capturePrediction&&!p.failed&&
+        p.decision.active()&&p.nextRefresh>0&&now>=p.nextRefresh&&
+        now-p.lastArrival<1000000;
+}
+void CapturePredictionSession::presented(int64_t now){
+    auto& p=*p_;p.lastPresent=now;
+    const auto interval=std::max<int64_t>(1,int64_t(10000000/p.settings.predictionRefreshHz));
+    if(p.newInput||p.nextRefresh<=0){p.nextRefresh=now+interval;p.newInput=false;}
+    else if(p.nextRefresh<=now)p.nextRefresh+=((now-p.nextRefresh)/interval+1)*interval;
+}
+void CapturePredictionSession::gpuCost(double ms){if(!std::isfinite(ms)||ms<0)return;p_->clock.gpuCost(ms);p_->lastCost=ms;}
+std::wstring CapturePredictionSession::status()const{
+    const auto& p=*p_;const wchar_t* state=p.failed?L"motion estimation unavailable / original image":p.decision.active()?L"active":p.decision.reason==PredictionReason::Budget?L"GPU budget bypass":p.decision.reason==PredictionReason::Stale?L"stale source bypass":L"warming up / original image";
+    const auto cost=std::isfinite(p.lastCost)?std::format(L"{:.2f}",p.lastCost):L"unmeasured";
+    return std::format(L"GPU capture prediction: {} | predicted horizon {:.1f} ms | PC ingress age {:.1f} ms | GPU {} ms | no added frame buffer (not measured latency saved)",state,p.decision.horizonMs,p.ageMs,cost);
+}
+}
