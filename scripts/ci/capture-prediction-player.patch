diff --git a/shaders/CapturePredictionIngress.hlsl b/shaders/CapturePredictionIngress.hlsl
new file mode 100644
index 0000000..0c46378
--- /dev/null
+++ b/shaders/CapturePredictionIngress.hlsl
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#include "HdrColor.hlsli"
+Texture2D<float4> Input : register(t0);
+RWTexture2D<float4> Linear : register(u0);
+RWTexture2D<float4> FlowColor : register(u1);
+SamplerState LinearClamp : register(s1);
+cbuffer Dims : register(b0) {
+    uint Width, Height, FlowWidth, FlowHeight;
+    uint Transfer; uint3 Padding;
+};
+float3 decode(float3 c) {
+    if(Transfer==2)return HdrDecodePq(c);
+    if(Transfer==1)return c;
+    c=max(c,0);
+    return select(c<=.04045,c/12.92,pow((c+.055)/1.055,2.4));
+}
+[numthreads(8,8,1)]
+void main(uint3 id : SV_DispatchThreadID) {
+    if(id.x<Width&&id.y<Height){float4 c=Input[id.xy];Linear[id.xy]=float4(decode(c.rgb),c.a);}
+    if(id.x<FlowWidth&&id.y<FlowHeight){
+        float3 c=Input.SampleLevel(LinearClamp,(float2(id.xy)+.5)/float2(FlowWidth,FlowHeight),0).rgb;
+        if(Transfer!=0){c=max(decode(c),0);c=c/(1+c);c=pow(c,1.0/2.2);}
+        FlowColor[id.xy]=float4(saturate(c),1);
+    }
+}
diff --git a/src/engine/CapturePredictionSession.cpp b/src/engine/CapturePredictionSession.cpp
new file mode 100644
index 0000000..c271677
--- /dev/null
+++ b/src/engine/CapturePredictionSession.cpp
@@ -0,0 +1,141 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#include "veyra/engine/CapturePredictionSession.h"
+#include "veyra/pipeline/CapturePredictionPass.h"
+#include "veyra/guidance/GpuDisOpticalFlow.h"
+#include <dxgi1_4.h>
+#include <bit>
+#include <format>
+#include <limits>
+namespace veyra::engine {
+using namespace pipeline;
+struct CapturePredictionSession::Impl {
+    PresentationSettings settings;
+    CapturePredictionClock clock;
+    CapturePredictionClock::Source latest{};
+    PredictionDecision decision;
+    FrameIdentity identity{};
+    ComputePass ingress;
+    StateTracker states;
+    ComPtr<ID3D12Resource> linear[2],flowColor[2],motion[2],confidence[2],predicted[2];
+    CapturePredictionPass predict[2];
+    guidance::GpuDisOpticalFlow flow;
+    uint32_t width=0,height=0,fw=0,fh=0,transfer=0;
+    unsigned parity=1;
+    uint64_t sequence=0,outputs=0;
+    int64_t lastPresent=0,lastArrival=0,nextRefresh=0;
+    double ageMs=0,lastCost=std::numeric_limits<double>::quiet_NaN();
+    bool valid=false,initialized=false,failed=false,newInput=false;
+};
+CapturePredictionSession::CapturePredictionSession():p_(std::make_unique<Impl>()){}
+CapturePredictionSession::~CapturePredictionSession()=default;
+bool CapturePredictionSession::initialize(ID3D12Device* device,ID3D12Resource* a,ID3D12Resource* b){
+    auto& p=*p_;if(!device||!a||!b)return false;
+    const auto d=a->GetDesc(),other=b->GetDesc();
+    if(!d.Width||!d.Height||d.Width>3840||d.Height>2160||other.Width!=d.Width||other.Height!=d.Height||other.Format!=d.Format)return false;
+    if(d.Format!=DXGI_FORMAT_R8G8B8A8_UNORM&&d.Format!=DXGI_FORMAT_B8G8R8A8_UNORM&&d.Format!=DXGI_FORMAT_R10G10B10A2_UNORM&&d.Format!=DXGI_FORMAT_R16G16B16A16_FLOAT)return false;
+    p.width=uint32_t(d.Width);p.height=d.Height;
+    const double scale=std::min(1.,640./std::max(p.width,p.height));
+    p.fw=std::max(32u,uint32_t(p.width*scale));p.fh=std::max(32u,uint32_t(p.height*scale));
+    p.transfer=d.Format==DXGI_FORMAT_R10G10B10A2_UNORM?2:d.Format==DXGI_FORMAT_R16G16B16A16_FLOAT?1:0;
+    // Include conservative DIS scratch allowance, in addition to our surfaces.
+    const uint64_t need=uint64_t(p.width)*p.height*32+uint64_t(p.fw)*p.fh*96+64*1024*1024;
+    ComPtr<IDXGIFactory4> factory;ComPtr<IDXGIAdapter3> adapter;
+    if(SUCCEEDED(CreateDXGIFactory1(IID_PPV_ARGS(&factory)))&&SUCCEEDED(factory->EnumAdapterByLuid(device->GetAdapterLuid(),IID_PPV_ARGS(&adapter)))){
+        DXGI_QUERY_VIDEO_MEMORY_INFO memory{};
+        if(SUCCEEDED(adapter->QueryVideoMemoryInfo(0,DXGI_MEMORY_SEGMENT_GROUP_LOCAL,&memory))&&memory.Budget>0&&
+            (memory.CurrentUsage>=memory.Budget||need>memory.Budget-memory.CurrentUsage)){log::warn("capture-prediction","insufficient local video-memory budget; original frames retained");return false;}
+    }
+    for(unsigned i=0;i<2;++i){
+        p.linear[i]=makeTexture(device,p.width,p.height,DXGI_FORMAT_R16G16B16A16_FLOAT,true);
+        p.predicted[i]=makeTexture(device,p.width,p.height,DXGI_FORMAT_R16G16B16A16_FLOAT,true);
+        p.flowColor[i]=makeTexture(device,p.fw,p.fh,DXGI_FORMAT_B8G8R8A8_UNORM,true);
+        p.motion[i]=makeTexture(device,p.fw,p.fh,DXGI_FORMAT_R16G16_FLOAT,true);
+        p.confidence[i]=makeTexture(device,p.fw,p.fh,DXGI_FORMAT_R16_FLOAT,true);
+        if(!p.linear[i]||!p.predicted[i]||!p.flowColor[i]||!p.motion[i]||!p.confidence[i])return false;
+    }
+    if(!p.flow.initialize(device,p.fw,p.fh))return false;
+    std::vector<uint8_t> shader;
+    if(!p.ingress.loadShader("CapturePredictionIngress.dxil",shader)||!p.ingress.create(device,shader,12,1,2,8,0,true))return false;
+    DescriptorStager stage;if(!stage.initialize(device,32))return false;
+    ID3D12Resource* inputs[]={a,b};
+    for(unsigned source=0;source<2;++source)for(unsigned i=0;i<2;++i){
+        const unsigned slot=(source*2+i)*3;
+        stage.stageSrv(inputs[source],nullptr,p.ingress.heap.Get(),slot);
+        makeUav(device,p.linear[i].Get(),DXGI_FORMAT_R16G16B16A16_FLOAT,cpuHandleOf(p.ingress,slot+1));
+        makeUav(device,p.flowColor[i].Get(),DXGI_FORMAT_B8G8R8A8_UNORM,cpuHandleOf(p.ingress,slot+2));
+    }
+    for(unsigned i=0;i<2;++i)if(!p.predict[i].initialize(device,{p.linear[i].Get(),p.linear[1-i].Get(),p.motion[i].Get(),p.motion[1-i].Get(),p.confidence[i].Get()},
+        {p.predicted[0].Get(),p.predicted[1].Get()}))return false;
+    p.initialized=true;
+    log::info("capture-prediction",std::format("GPU DIS + prediction initialized {}x{} flow={}x{}; native presentation, no future-frame wait",p.width,p.height,p.fw,p.fh));
+    return true;
+}
+void CapturePredictionSession::configure(PresentationSettings s){
+    if(p_->settings.capturePrediction!=s.capturePrediction)reset();p_->settings=s;
+}
+void CapturePredictionSession::reset(){auto& p=*p_;p.clock.clear();p.identity={};p.valid=false;p.sequence=0;p.lastPresent=0;p.nextRefresh=0;p.newInput=false;p.decision={};}
+ID3D12Resource* CapturePredictionSession::record(ID3D12GraphicsCommandList* list,ID3D12CommandQueue* queue,ID3D12Fence* fence,uint64_t completion,
+    unsigned sourceSlot,FrameIdentity id,int64_t pts,int64_t arrival,int64_t now,bool refresh){
+    auto& p=*p_;if(!p.initialized||!p.settings.capturePrediction||p.failed||sourceSlot>=2||!list||!queue||!fence)return nullptr;
+    const bool fresh=!p.valid||id!=p.identity;
+    if(refresh&&fresh)return nullptr;
+    if(fresh){
+        const bool resetHistory=!p.valid||id.epoch!=p.identity.epoch||id.settingsRevision!=p.identity.settingsRevision;
+        const auto old=p.parity;p.parity^=1;
+        p.latest={id.epoch,id.settingsRevision,++p.sequence,pts,arrival,true,false,resetHistory};
+        const auto accepted=p.clock.accept(p.latest);
+        const bool history=!resetHistory&&accepted==PredictionReason::Ready;
+        const uint32_t dims[8]={p.width,p.height,p.fw,p.fh,p.transfer,0,0,0};
+        const unsigned slot=(sourceSlot*2+p.parity)*3;
+        // The producer handoff is GPU-side; both graph outputs are COMMON here.
+        p.states.transition(list,p.linear[p.parity].Get(),D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+        p.states.transition(list,p.flowColor[p.parity].Get(),D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
