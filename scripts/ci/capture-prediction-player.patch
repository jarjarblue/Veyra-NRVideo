index 0000000..fa07036
--- /dev/null
+++ b/qml/Veyra/CapturePredictionEditor.qml
@@ -0,0 +1,66 @@
+import QtQuick
+import QtQuick.Layouts
+ColumnLayout {
+    id: root
+    property var backend: veyra
+    property string namePrefix: "list"
+    Layout.fillWidth: true
+    spacing: 4
+    VRow {
+        label: qsTr("GPU capture prediction")
+        hintBelow: true
+        hint: qsTr("Experimental live preview. Predicts observed motion without waiting for future frames. Enabling turns interpolation off, selects minimum capture buffering and uses its own refresh control with tearing allowed. Reopen capture to apply its allocator setting. Recordings keep the original source timeline.")
+        VSwitch {
+            objectName: root.namePrefix+"-capture-prediction"
+            checked: root.backend.capturePrediction === true
+            onToggled: checked => root.backend.capturePrediction=checked
+        }
+    }
+    ColumnLayout {
+        visible: root.backend.capturePrediction === true
+        Layout.fillWidth: true
+        VRow {
+            label: qsTr("Estimated compensation")
+            value: Number(root.backend.predictionLeadMs ?? 8).toFixed(1)+" ms"
+            VSlider {
+                objectName: root.namePrefix+"-prediction-lead"
+                width: 140; from: 0; to: 30; stepSize: .5; live: false; valueFromModel: true
+                value: root.backend.predictionLeadMs ?? 8
+                onMoved: value => root.backend.predictionLeadMs=value
+            }
+        }
+        VRow {
+            label: qsTr("Prediction refresh rate")
+            value: Number(root.backend.predictionRefreshHz ?? 120).toFixed(0)+" Hz"
+            VSlider {
+                objectName: root.namePrefix+"-prediction-refresh"
+                width: 140; from: 30; to: 240; stepSize: 1; live: false; valueFromModel: true
+                value: root.backend.predictionRefreshHz ?? 120
+                onMoved: value => root.backend.predictionRefreshHz=value
+            }
+        }
+        VRow {
+            label: qsTr("Maximum prediction horizon")
+            value: Number(root.backend.predictionMaxHorizonMs ?? 33).toFixed(0)+" ms"
+            VSlider {
+                objectName: root.namePrefix+"-prediction-horizon"
+                width: 140; from: 1; to: 50; stepSize: 1; live: false; valueFromModel: true
+                value: root.backend.predictionMaxHorizonMs ?? 33
+                onMoved: value => root.backend.predictionMaxHorizonMs=value
+            }
+        }
+        VRow {
+            label: qsTr("Protect HUD corners and reticle")
+            VSwitch {
+                objectName: root.namePrefix+"-prediction-hud"
+                checked: root.backend.predictionProtectHud !== false
+                onToggled: checked => root.backend.predictionProtectHud=checked
+            }
+        }
+        Text {
+            Layout.fillWidth: true
+            text: qsTr("Start with 8 ms at 120 Hz. Larger forecasts can distort motion. Uncertain areas use the latest image; unseen input and geometry cannot be recovered. Compensation is an estimate, not measured latency removed.")
+            color: Theme.t3; font.pixelSize: 11; wrapMode: Text.WordWrap
+        }
+    }
+}
