+++ b/third_party/gpu-dis/src/gpu/shaders/dis_integer_area.hlsl
@@ -0,0 +1,29 @@
+// Distribution note (2026-09-09): project-owned additions and modifications
+// are licensed under Apache-2.0. Upstream portions retain their original
+// licenses and attribution; see NOTICE, PROVENANCE.md and licenses/.
+// OpenCV DIS/reference-derived portions retain Intel (2000-2008), Willow
+// Garage (2009) and other upstream copyrights and BSD/Apache terms.
+// See licenses/OPENCV_DIS_BSD_HEADER.txt and OPENCV_APACHE_LICENSE.txt.
+
+// Integer pyramid ratios use exact integer accumulation and rounding without
+// compiling the generic FP64 tap-table path into this dispatch.
+Texture2D<float> Source : register(t0);
+RWTexture2D<float> Destination : register(u0);
+cbuffer Params : register(b0) { uint srcWidth; uint srcHeight; uint dstWidth; uint dstHeight; };
+[numthreads(8,8,1)]
+void main(uint3 id : SV_DispatchThreadID) {
+    if(id.x>=dstWidth||id.y>=dstHeight||dstWidth==0||dstHeight==0)return;
+    uint sx=srcWidth/dstWidth, sy=srcHeight/dstHeight;
+    if(sx==0||sy==0)return;
+    uint sum=0;
+    for(uint y=0;y<sy;++y)for(uint x=0;x<sx;++x)
+        sum+=(uint)Source.Load(int3(id.x*sx+x,id.y*sy+y,0));
+    uint area=sx*sy, value;
+    if(sx==1&&sy==1)value=sum;
+    else if(sx==2&&sy==2)value=(sum+2)>>2;
+    else {
+        uint q=sum/area, r=sum%area;
+        value=q+((r*2>area)||(r*2==area&&(q&1))?1:0);
+    }
+    Destination[id.xy]=(float)value;
+}
