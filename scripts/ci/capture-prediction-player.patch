diff --git a/tests/integration/CapturePredictionSessionTests.cpp b/tests/integration/CapturePredictionSessionTests.cpp
new file mode 100644
index 0000000..f03c1df
--- /dev/null
+++ b/tests/integration/CapturePredictionSessionTests.cpp
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#define VEYRA_PREDICTION_GPU_TEST_HELPERS
+#include "CapturePredictionGpuTests.cpp"
+#include "veyra/engine/CapturePredictionSession.h"
+using namespace veyra::engine;
+int main() try {
+    Test t;CapturePredictionSession session;
+    ComPtr<ID3D12Resource> source[2];
+    for(auto& r:source)r=makeTexture(t.device.Get(),W,H,DXGI_FORMAT_R8G8B8A8_UNORM,false);
+    require(session.initialize(t.device.Get(),source[0].Get(),source[1].Get()),"initialize integrated GPU DIS prediction session");
+    PresentationSettings settings;settings.capturePrediction=true;settings.predictionProtectHud=false;
+    session.configure(settings);
+    unsigned forecasts=0;double error=0,holdError=0;
+    auto decode=[](float v){return v<=.04045f?v/12.92f:std::pow((v+.055f)/1.055f,2.4f);};
+    for(unsigned frame=1;frame<=10;++frame){
+        t.begin();const unsigned parity=frame%2;const float shift=float(frame*2);
+        std::vector<uint8_t> pixels(W*H*4);
+        for(unsigned y=0;y<H;++y)for(unsigned x=0;x<W;++x){
+            const auto value=uint8_t(std::lround(pattern(float(x)-shift,float(y))*255));
+            for(unsigned c=0;c<3;++c)pixels[(y*W+x)*4+c]=value;pixels[(y*W+x)*4+3]=255;
+        }
+        t.upload(source[parity].Get(),pixels);
+        t.tracker.transition(t.list.Get(),source[parity].Get(),D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+        const int64_t pts=int64_t(frame-1)*333333,arrival=100000000+pts;
+        auto* forecast=session.record(t.list.Get(),t.queue.Get(),t.fence.Get(),t.value+1,parity,{1,1,frame},pts,arrival,arrival,false);
+        t.tracker.transition(t.list.Get(),source[parity].Get(),D3D12_RESOURCE_STATE_COMMON);
+        ComPtr<ID3D12Resource> readback;D3D12_PLACED_SUBRESOURCE_FOOTPRINT footprint{};UINT rows;UINT64 rowBytes,total;
+        if(forecast){
+            ++forecasts;auto desc=forecast->GetDesc();t.device->GetCopyableFootprints(&desc,0,1,0,&footprint,&rows,&rowBytes,&total);
+            D3D12_HEAP_PROPERTIES heap{};heap.Type=D3D12_HEAP_TYPE_READBACK;
+            D3D12_RESOURCE_DESC buffer{};buffer.Dimension=D3D12_RESOURCE_DIMENSION_BUFFER;buffer.Width=total;buffer.Height=1;
+            buffer.DepthOrArraySize=buffer.MipLevels=1;buffer.SampleDesc.Count=1;buffer.Layout=D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+            hr(t.device->CreateCommittedResource(&heap,D3D12_HEAP_FLAG_NONE,&buffer,D3D12_RESOURCE_STATE_COPY_DEST,nullptr,IID_PPV_ARGS(&readback)),"session readback");
+            StateTracker temporary;temporary.transition(t.list.Get(),forecast,D3D12_RESOURCE_STATE_COPY_SOURCE);
+            D3D12_TEXTURE_COPY_LOCATION a{},b{};a.pResource=readback.Get();a.Type=D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;a.PlacedFootprint=footprint;
+            b.pResource=forecast;b.Type=D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;t.list->CopyTextureRegion(&a,0,0,0,&b,nullptr);
+            temporary.transition(t.list.Get(),forecast,D3D12_RESOURCE_STATE_COMMON);
+        }
+        t.finish();session.presented(arrival);
+        if(forecast){
+            void* mapped;D3D12_RANGE range{0,size_t(total)};hr(readback->Map(0,&range,&mapped),"session map");
+            for(unsigned y=12;y<H-12;++y)for(unsigned x=16;x<W-16;++x){
+                const auto* pixel=reinterpret_cast<const uint16_t*>(static_cast<const uint8_t*>(mapped)+y*footprint.Footprint.RowPitch)+x*4;
+                const double future=decode(pattern(float(x)-shift-2.f*8.f/(1000.f/30),float(y)));
+                error+=std::abs(XMConvertHalfToFloat(pixel[0])-future);
+                holdError+=std::abs(decode(pixels[(y*W+x)*4]/255.f)-future);
+                require(std::isfinite(XMConvertHalfToFloat(pixel[0])),"finite estimated-motion output");
+            }
+            D3D12_RANGE empty{0,0};readback->Unmap(0,&empty);
+        }
+        require(!session.due(arrival+1000),"no refresh before output deadline");
+    }
+    require(forecasts>=8,"real estimated-motion warmup produces forecasts");
+    std::cout<<"Estimated-motion session error "<<holdError<<" -> "<<error<<" forecasts="<<forecasts<<'\n';
+    require(error<holdError*.98,"estimated optical flow must improve prediction against future truth");
+    session.reset();require(!session.due(200000000),"reset clears refresh ownership");
+    t.checkDebug();std::cout<<"GPU DIS + capture prediction integration PASS (WARP, not Radeon performance)\n";return 0;
+}catch(const std::exception& error){std::cerr<<"FAIL "<<error.what()<<'\n';return 1;}
diff --git a/tests/qml/CapturePredictionPreferencesTests.cpp b/tests/qml/CapturePredictionPreferencesTests.cpp
new file mode 100644
index 0000000..0d6e067
--- /dev/null
+++ b/tests/qml/CapturePredictionPreferencesTests.cpp
@@ -0,0 +1,31 @@
+#include "veyra/engine/EngineController.h"
+#include "veyra/ui/QmlPlayerBridge.h"
+#include <QGuiApplication>
+#include <filesystem>
+#include <iostream>
+#include <limits>
+#include <cstdlib>
+int main(int argc,char** argv){
+    QGuiApplication app(argc,argv);if(argc!=2)return 2;
+    const std::filesystem::path profile=argv[1];std::filesystem::create_directories(profile);
+    unsigned checks=0;auto check=[&](bool v,const char* label){++checks;if(!v){std::cerr<<"FAIL "<<label<<'\n';std::exit(1);}};
+    {
+        veyra::engine::EngineController engine;veyra::ui::QmlPlayerBridge bridge(engine,profile);
+        check(!bridge.capturePrediction(),"new profiles default to prediction off");
+        bridge.setCapturePrediction(true);check(bridge.capturePrediction(),"mode enabled");
+        check(!bridge.fgEnabled(),"interpolation disabled for native prediction");
+        check(bridge.captureBufferMode()==1,"minimum capture allocator requested");
+        bridge.setCaptureBufferMode(0);check(bridge.captureBufferMode()==1,"mode keeps minimum buffering");
+        bridge.setPredictionLeadMs(12.5);bridge.setPredictionRefreshHz(144);bridge.setPredictionMaxHorizonMs(40);bridge.setPredictionProtectHud(false);
+        bridge.setPredictionLeadMs(std::numeric_limits<double>::infinity());check(bridge.predictionLeadMs()==12.5,"reject invalid lead");
+        bridge.setPredictionRefreshHz(999);check(bridge.predictionRefreshHz()==144,"reject invalid refresh");
+    }
+    {
+        veyra::engine::EngineController engine;veyra::ui::QmlPlayerBridge bridge(engine,profile);
+        check(bridge.capturePrediction(),"mode survives restart");check(!bridge.fgEnabled(),"interpolation stays off after restart");
+        check(bridge.captureBufferMode()==1,"allocator preference survives restart");
+        check(bridge.predictionLeadMs()==12.5&&bridge.predictionRefreshHz()==144&&bridge.predictionMaxHorizonMs()==40&&!bridge.predictionProtectHud(),"all controls survive restart");
+        bridge.setCapturePrediction(false);check(!bridge.capturePrediction(),"mode can be disabled");
+    }
+    std::cout<<"Prediction real bridge/preferences: "<<checks<<" checks, 0 failures\n";return 0;
+}
